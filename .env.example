# Live-integration knobs for the BYOK provider seam. The live copy is the
# gitignored `.env` at the repo root; never commit real values. The
# integration recipes read these; when any of them is missing or empty
# the live corpus SKIPs, never fails, so CI (which carries no .env)
# stays green. Names and defaults follow the suite test gateway.

# OpenAI-compatible base URL, including the /v1 prefix.
TEST_BYOK_BASE_URL=http://localhost:17844/v1
# API key for the gateway; empty means the live corpora skip.
TEST_BYOK_API_KEY=
# Model id the live corpora request.
TEST_BYOK_MODEL=harhaial
# Reserved for the vision corpus; not consumed yet.
TEST_BYOK_VISION_MODEL=images
# Anthropic Messages base URL for the live anthropic corpus; empty
# means the corpus skips.
TEST_BYOK_ANTHROPIC_BASE_URL=
# Anthropic API key for the live anthropic corpus; empty means the
# corpus skips.
TEST_BYOK_ANTHROPIC_API_KEY=
# Anthropic model id the live anthropic corpus requests.
TEST_BYOK_ANTHROPIC_MODEL=

# gh token for the runner simulation harness (gitignored; never commit real
# values). On a real runner this arrives from Actions secrets or the
# builtin token instead.
GH_TOKEN=

# Runtime knob the agent binary reads from the process environment:
# total attempts per model step when a gateway drops a stream mid-turn.
# 0 restores fail-fast (one attempt); the default is 3.
CRAFT_AGENT_STEP_RETRIES=3

# Runtime knob the agent binary reads from the process environment:
# turns of tool results kept verbatim in the assembled prompt; older
# results ride as size stubs while the session record keeps full content.
# 0 disables trimming; the default is 20.
CRAFT_AGENT_RESULT_WINDOW_TURNS=20

# Runtime knob the tools read from the process environment: comma-
# separated hosts a bash command may talk to. Unset or empty means no
# egress gate; a non-empty list that names no host denies all network.
CRAFT_AGENT_EGRESS_ALLOWLIST=github.com,api.github.com,codeload.github.com,objects.githubusercontent.com

# Runtime knob the tools read from the process environment: the single
# owner/name repository the gh tool may write to. Unset or empty means
# no write gate; a malformed value denies writes fail-closed.
CRAFT_AGENT_WRITE_REPO=

# Runtime knob the agent binary reads from the process environment:
# optional Anthropic base URL override; unset or empty keeps the fixed
# Messages host default.
ANTHROPIC_BASE_URL=

# Runtime knob the agent binary reads from the process environment: how
# the Anthropic key rides. `x-api-key` (the default, and what unset or
# empty means) or `bearer`; any other value is a named error.
ANTHROPIC_AUTH=
