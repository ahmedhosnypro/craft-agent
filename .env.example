# Live-integration knobs for the BYOK provider seam. The live copy is the
# gitignored `.env` at the repo root; never commit real values. The
# integration recipes read these; when any of them is missing or empty
# the live corpus SKIPs, never fails, so CI (which carries no .env)
# stays green. Names and defaults follow the suite test gateway.

# OpenAI-compatible base URL, including the /v1 prefix.
TEST_BYOK_BASE_URL=http://localhost:17844/v1
# API key for the gateway; empty means the live corpora skip.
TEST_BYOK_API_KEY=
# Model id the live corpora request.
TEST_BYOK_MODEL=harhaial
# Reserved for the vision corpus; not consumed yet.
TEST_BYOK_VISION_MODEL=images
# Anthropic Messages base URL for the live anthropic corpus; empty
# means the corpus skips.
TEST_BYOK_ANTHROPIC_BASE_URL=
# Anthropic API key for the live anthropic corpus; empty means the
# corpus skips.
TEST_BYOK_ANTHROPIC_API_KEY=
# Anthropic model id the live anthropic corpus requests.
TEST_BYOK_ANTHROPIC_MODEL=

# Gemini API base URL for the live gemini corpus; empty means the
# production Gemini host.
TEST_BYOK_GEMINI_BASE_URL=
# Gemini API key for the live gemini corpus; empty means the corpus
# skips.
TEST_BYOK_GEMINI_API_KEY=
# Gemini model id the live gemini corpus requests.
TEST_BYOK_GEMINI_MODEL=

# gh token for the runner simulation harness (gitignored; never commit real
# values). On a real runner this arrives from Actions secrets or the
# builtin token instead.
GH_TOKEN=

# Runtime knob the agent binary reads from the process environment:
# total attempts per model step when a gateway drops a stream mid-turn.
# 0 restores fail-fast (one attempt); the default is 3.
CRAFT_AGENT_STEP_RETRIES=3

# Runtime knob the agent binary reads from the process environment:
# turns of tool results kept verbatim in the assembled prompt; older
# results ride as size stubs while the session record keeps full
# content. 0 (the default) keeps the prompt append-only, preserving
# gateway cache affinity; a nonzero window trades that affinity for
# smaller prompts.
CRAFT_AGENT_RESULT_WINDOW_TURNS=0

# Runtime knob the agent binary reads from the process environment:
# bytes of each tool result kept verbatim in the assembled prompt;
# oversized results ride as their head plus a pointer to a spill file
# under RUNNER_TEMP while the session record keeps full content.
# 0 disables truncation; the default is 4096.
CRAFT_AGENT_RESULT_TRUNCATE_BYTES=4096

# Runtime knobs the agent binary reads from the process environment for
# context management: the context window cap in tokens (unset disables
# auto-compaction entirely), the input-side compaction trigger limit
# (unset falls back to the context cap), and the per-request output
# cap in tokens (unset keeps the 8192 default). Each must be a whole
# number of at least 1; a garbage or zero value fails the run with a
# typed error naming the knob. CLI flags --max-context-tokens,
# --max-input-tokens, --max-output-tokens and the agent-file
# frontmatter keys maxContextTokens/maxInputTokens/maxOutputTokens
# outrank these.
CRAFT_AGENT_MAX_CONTEXT_TOKENS=
CRAFT_AGENT_MAX_INPUT_TOKENS=
CRAFT_AGENT_MAX_OUTPUT_TOKENS=

# Runtime knob the agent binary reads from the process environment: the
# thinking level forwarded to the provider. `none` or `off` disables
# thinking; any other value passes through verbatim (at most 128
# bytes). The CLI flag --thinking-level and the frontmatter key
# `thinking` outrank this.
CRAFT_AGENT_THINKING_LEVEL=

# Runtime knob the tools read from the process environment: comma-
# separated hosts a bash command may talk to. Unset or empty means no
# egress gate; a non-empty list that names no host denies all network.
CRAFT_AGENT_EGRESS_ALLOWLIST=github.com,api.github.com,codeload.github.com,objects.githubusercontent.com

# Runtime knob the tools read from the process environment: the single
# owner/name repository the gh tool may write to. Unset or empty means
# no write gate; a malformed value denies writes fail-closed.
CRAFT_AGENT_WRITE_REPO=

# Runtime knob the tools read from the process environment: comma-
# separated extra read-only roots for read_file, glob, and grep,
# absolute paths only. Unset or empty means no extra read roots; at
# most 4 are honored, and an oversized value grants nothing.
CRAFT_AGENT_READ_ROOTS=

# Runtime knob the agent binary reads from the process environment:
# optional Anthropic base URL override; unset or empty keeps the fixed
# Messages host default.
ANTHROPIC_BASE_URL=

# Runtime knob the agent binary reads from the process environment: how
# the Anthropic key rides. `x-api-key` (the default, and what unset or
# empty means) or `bearer`; any other value is a named error.
ANTHROPIC_AUTH=

# Runtime knobs the subagent runtime reads from the process environment:
# CRAFT_AGENT_SUBAGENT_MAX_DEPTH (0 disables spawning, ceiling 4),
# MAX_TOTAL (1..=256 children), MAX_CONCURRENCY (1..=16 in flight).
CRAFT_AGENT_SUBAGENT_MAX_DEPTH=2
CRAFT_AGENT_SUBAGENT_MAX_TOTAL=32
CRAFT_AGENT_SUBAGENT_MAX_CONCURRENCY=4

# Runtime knob the tools read from the process environment: allow MCP
# servers named by .craft-agent/mcp.json to mount their tools. Values
# are 1 (on) or 0 (off); unset or empty stays off. The total tool cap
# across servers defaults to 128.
CRAFT_AGENT_MCP=0
CRAFT_AGENT_MCP_MAX_TOOLS=128
