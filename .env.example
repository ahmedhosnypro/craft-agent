# Live-integration knobs for the BYOK provider seam. The live copy is the
# gitignored `.env` at the repo root; never commit real values. The
# integration recipes read these; when any of them is missing or empty
# the live corpus SKIPs, never fails, so CI (which carries no .env)
# stays green. Names and defaults follow the suite test gateway.

# OpenAI-compatible base URL, including the /v1 prefix.
TEST_BYOK_BASE_URL=http://localhost:17844/v1
# API key for the gateway; empty means the live corpora skip.
TEST_BYOK_API_KEY=
# Model id the live corpora request.
TEST_BYOK_MODEL=harhaial
# Reserved for the vision corpus; not consumed yet.
TEST_BYOK_VISION_MODEL=images

# gh token for the runner simulation harness (gitignored; never commit real
# values). On a real runner this arrives from Actions secrets or the
# builtin token instead.
GH_TOKEN=
